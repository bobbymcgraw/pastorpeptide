---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { COMPOUND_GROUP_ORDER, COMPOUND_GROUP_COLORS, groupBy } from '../../lib/groups';

const compounds = await getCollection('compounds');
compounds.sort((a, b) => a.data.title.localeCompare(b.data.title));
const grouped = groupBy(compounds, COMPOUND_GROUP_ORDER);
---
<Layout title="Peptide Encyclopedia">
  <div class="wrap header">
    <a class="back" href="/seminary">&larr; The Seminary</a>
    <span class="chapter-label">The Book of Peptides</span>
    <h1>Peptide Encyclopedia</h1>
    <p class="lede">{compounds.length} compounds, organized by category &mdash; the scripture on each one the congregation actually asks about.</p>
    <div class="search-wrap">
      <input type="search" id="compoundSearch" placeholder="Already know what you're looking for? Search by name…" autocomplete="off" />
      <span class="search-count" id="searchCount"></span>
    </div>
  </div>

  <div class="wrap groups" id="groupsWrap">
    {grouped.map(({ group, items }) => (
      <section class="group" data-group style={`--accent-color: ${COMPOUND_GROUP_COLORS[group] || 'var(--gold)'}`}>
        <h2><span class="group-dot"></span>{group}</h2>
        <div class="grid grid-cards">
          {items.map((c) => (
            <a class="card" href={`/compounds/${c.slug}`} data-title={c.data.title.toLowerCase()}>
              <h3>{c.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="no-results" id="noResults" hidden>No compounds match "<span id="noResultsQuery"></span>". Try a different spelling, or browse the categories above.</p>
  </div>
</Layout>

<style>
  .header {
    padding: 40px 20px 24px;
  }
  .back {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
  }
  h1 { margin: 6px 0 6px; }
  .lede { color: var(--text-muted); max-width: 600px; }
  .search-wrap {
    margin-top: 20px;
    max-width: 420px;
    position: relative;
  }
  #compoundSearch {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.95rem;
    font-family: var(--font-body);
    background: var(--white);
    color: var(--text);
  }
  #compoundSearch:focus {
    outline: none;
    border-color: var(--amber-red);
  }
  .search-count {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .groups {
    padding: 0 20px 60px;
  }
  .group {
    margin-top: 40px;
  }
  .group h2 {
    margin-top: 0;
    font-size: 1.15rem;
    color: var(--navy);
    border-bottom: 2px solid var(--accent-color, var(--border));
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .group-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-color, var(--gold));
    flex-shrink: 0;
  }
  .group .card {
    border-top: 3px solid var(--accent-color, var(--border));
  }
  .no-results {
    margin-top: 40px;
    color: var(--text-muted);
  }
</style>

<script>
  const searchInput = document.getElementById('compoundSearch') as HTMLInputElement;
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.card[data-title]');
  const searchCount = document.getElementById('searchCount')!;
  const noResults = document.getElementById('noResults')!;
  const noResultsQuery = document.getElementById('noResultsQuery')!;

  function runSearch() {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    groups.forEach((group) => {
      let groupHasMatch = false;
      group.querySelectorAll<HTMLAnchorElement>('.card[data-title]').forEach((card) => {
        const match = !query || (card.dataset.title || '').includes(query);
        card.hidden = !match;
        if (match) {
          groupHasMatch = true;
          visibleCount += 1;
        }
      });
      group.hidden = !groupHasMatch;
    });

    if (!query) {
      searchCount.textContent = '';
    } else {
      searchCount.textContent = `${visibleCount} match${visibleCount === 1 ? '' : 'es'}`;
    }

    noResults.hidden = !(query && visibleCount === 0);
    noResultsQuery.textContent = searchInput.value.trim();
  }

  searchInput.addEventListener('input', runSearch);
</script>
