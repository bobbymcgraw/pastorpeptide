      { slug: 'mots-c', name: 'MOTS-c', why: 'A mitochondrial-derived peptide tied to metabolic and longevity research.' },
      { slug: 'ghk-cu', name: 'GHK-Cu', why: 'Beyond healing, it is one of the most-studied peptides for skin and collagen aging.' },
    ],
