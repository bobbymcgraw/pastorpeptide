      { slug: 'selank', name: 'Selank', why: 'Anxiolytic and cognitive support in one peptide.' },
      { slug: 'dihexa', name: 'Dihexa', why: 'One of the more potent nootropics in the encyclopedia, studied for neurogenesis.' },
      { slug: 'cerebrolysin', name: 'Cerebrolysin', why: 'A neurotrophic peptide mix used for cognitive support and recovery.' },
    ],
  },
  {
    id: 'anti-aging',
    label: 'Anti-Aging & Longevity',
    icon: '⏳',
