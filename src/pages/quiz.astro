      { slug: 'ipamorelin', name: 'Ipamorelin', why: 'A clean GH secretagogue with minimal effect on cortisol or hunger.' },
      { slug: 'mk-677', name: 'MK-677 (Ibutamoren)', why: 'An oral option for raising GH and IGF-1 without injections.' },
      { slug: 'tesamorelin', name: 'Tesamorelin', why: 'A GHRH analogue studied specifically for lean mass and visceral fat.' },
    ],
  },
  {
    id: 'healing',
    label: 'Injury Healing & Recovery',
    icon: '🩹',
    blurb: "The go-to peptides for tendons, joints, gut lining, and general tissue repair.",
    picks: [
      { slug: 'bpc-157', name: 'BPC-157', why: 'The most widely discussed healing peptide — gut, tendon, and soft-tissue repair.' },
      { slug: 'tb500', name: 'TB-500 (Thymosin Beta-4)', why: 'Often stacked with BPC-157 for broader tissue and inflammation support.' },
      { slug: 'ghk-cu', name: 'GHK-Cu', why: 'Copper peptide studied for tissue remodeling and wound healing.' },
      { slug: 'kpv', name: 'KPV', why: 'An anti-inflammatory peptide fragment of alpha-MSH.' },
    ],
  },
  {
    id: 'sleep',
    label: 'Better Sleep',
    icon: '🌙',
    blurb: "A short list — sleep is one of the smaller categories in the encyclopedia.",
    picks: [
      { slug: 'dsip', name: 'DSIP (Delta Sleep-Inducing Peptide)', why: 'The peptide most specifically associated with sleep onset and quality.' },
