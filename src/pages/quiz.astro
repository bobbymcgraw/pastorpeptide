      { slug: 'retatrutide-deep-dive', name: 'Retatrutide', why: 'Triple agonist showing the deepest fat-loss numbers of the GLP-1 family so far.' },
      { slug: 'aod-9604', name: 'AOD-9604', why: 'A fat-targeting GH fragment for people looking for a non-GLP-1 route.' },
