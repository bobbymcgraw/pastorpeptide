      { slug: 'thymosin-alpha-1', name: 'Thymosin Alpha-1', why: 'The classic immune-modulating peptide, well studied across immune conditions.' },
      { slug: 'ldn', name: 'Low Dose Naltrexone (LDN)', why: 'A repurposed prescription drug widely used off-label for immune modulation.' },
      { slug: 'thymalin', name: 'Thymalin', why: 'A thymus bioregulator from the Khavinson peptide bioregulator family.' },
