---
<Layout title="Find Your Starting Point" description="Pick your goal — weight loss, sleep, focus, recovery, and more — and get 3-4 curated peptide picks pulled straight from the encyclopedia.">
  <div class="wrap header">
    <a class="back" href="/seminary">&larr; The Seminary</a>
    <span class="chapter-label">The Consultation</span>
    <h1>Find Your Starting Point</h1>
    <p class="lede">Tell me what you're actually trying to do, and I'll point you to the compounds most people start with &mdash; straight to the encyclopedia page for each one. This isn't a prescription. It's a place to start reading.</p>
  </div>

  <div class="wrap quiz">
    <div id="goal-picker" class="goal-grid">
      {goals.map((g) => (
        <button class="goal-btn" data-goal={g.id}>
          <span class="goal-icon">{g.icon}</span>
          <span>{g.label}</span>
        </button>
      ))}
    </div>

    {goals.map((g) => (
      <div class="results" id={`results-${g.id}`} hidden>
        <button class="reset">&larr; Pick a different goal</button>
        <h2>{g.icon} {g.label}</h2>
        <p class="results-blurb">{g.blurb}</p>
        <div class="grid grid-cards">
          {g.picks.map((p) => (
            <a class="card" href={`/compounds/${p.slug}`}>
              <h3>{p.name}</h3>
              <p class="why">{p.why}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .header { padding: 40px 20px 24px; }
  .back { color: var(--text-muted); text-decoration: none; font-size: 0.88rem; }
  h1 { margin: 6px 0 6px; }
  .lede { color: var(--text-muted); max-width: 640px; }
  .quiz { padding: 0 20px 60px; }

  .goal-grid[hidden] { display: none; }
  .goal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }
  .goal-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 16px;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text);
    text-align: center;
    transition: border-color 0.15s, transform 0.15s;
  }
  .goal-btn:hover {
    border-color: var(--amber-red);
    transform: translateY(-2px);
  }
  .goal-icon { font-size: 1.8rem; }

  .results { margin-top: 10px; }
  .reset {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0;
    margin-bottom: 20px;
  }
  .reset:hover { color: var(--amber-red); }
  .results h2 { margin: 0 0 6px; }
  .results-blurb { color: var(--text-muted); max-width: 600px; margin-bottom: 24px; }
  .why {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 6px 0 0;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.goal-btn');
  const picker = document.getElementById('goal-picker');
  const allResults = document.querySelectorAll<HTMLElement>('.results');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const goal = btn.dataset.goal;
      picker?.setAttribute('hidden', '');
      allResults.forEach((r) => {
        r.hidden = r.id !== `results-${goal}`;
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.reset').forEach((btn) => {
    btn.addEventListener('click', () => {
      allResults.forEach((r) => r.setAttribute('hidden', ''));
      picker?.removeAttribute('hidden');
    });
  });
</script>
