---
const nav = [
  { href: '/', label: 'Start Here' },
  { href: '/seminary', label: 'The Seminary' },
  { href: '/quiz', label: 'Find Your Peptide' },
  {
    href: '/reconstitution-calculator',
    label: 'The Sacred Math',
    children: [
      { href: '/reconstitution-calculator', label: 'Reconstitution Calculator' },
      { href: '/tdee-calculator', label: 'Calorie Calculator' },
    ],
  },
  { href: '/links', label: 'The Directory' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <img class="brand-mark" src="/images/pastor-peptide-mark-320.png" alt="" width="36" height="36" />
      <span class="brand-name">Pastor Peptide</span>
    </a>

    <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="siteNav">
      {nav.map((item) => (
        item.children ? (
          <details class="nav-dropdown">
            <summary
              class={`dropdown-trigger ${path.startsWith(item.href) || item.children.some((c) => path.startsWith(c.href)) ? 'active' : ''}`}
            >
              {item.label} <span class="caret">▾</span>
            </summary>
            <div class="dropdown-menu">
              <a href={item.href} class={path === item.href ? 'active' : ''}>
                {item.label} (overview)
              </a>
              {item.children.map((child) => (
                <a href={child.href} class={path.startsWith(child.href) ? 'active' : ''}>
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'active' : ''}
          >
            {item.label}
          </a>
        )
      ))}
      <a href="https://bobbymcgraw.com" target="_blank" rel="noopener noreferrer">Meet the Pastor</a>
      <a class="cta" href="https://calendly.com/bobbymcgraw/pastor-peptide-call" target="_blank" rel="noopener noreferrer">Book a Call</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(24,25,22,0.18);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    max-width: 900px;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    display: block;
    box-shadow: none;
    border-radius: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--gold-light);
    font-size: 1.05rem;
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    background: rgba(255,255,255,0.85);
    border-radius: 2px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .site-nav > a {
    color: rgba(255,255,255,0.75);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav > a:hover,
  .site-nav > a.active {
    color: var(--gold-light);
  }
  .site-nav > a.cta {
    background: var(--gold);
    color: var(--white);
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
  }
  .site-nav > a.cta:hover {
    background: var(--amber-red);
    color: var(--white);
  }

  .nav-dropdown {
    position: relative;
  }
  .dropdown-trigger {
    color: rgba(255,255,255,0.75);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    list-style: none;
  }
  .dropdown-trigger::-webkit-details-marker {
    display: none;
  }
  .dropdown-trigger:hover,
  .dropdown-trigger.active {
    color: var(--gold-light);
  }
  .caret {
    font-size: 0.7rem;
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 10px;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: var(--navy);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 6px;
    margin-top: 10px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  }
  .dropdown-menu a {
    color: rgba(255,255,255,0.75);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    padding: 9px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .dropdown-menu a:hover,
  .dropdown-menu a.active {
    background: rgba(255,255,255,0.08);
    color: var(--gold-light);
  }

  @media (max-width: 720px) {
    .bar { padding: 12px 20px; position: relative; }
    .nav-toggle { display: flex; }
    .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      margin-top: 14px;
    }
    .site-nav.mobile-open { display: flex; }
    .site-nav > a,
    .dropdown-trigger {
      width: 100%;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .site-nav > a.cta {
      width: auto;
      border: none;
      margin-top: 10px;
    }
    .nav-dropdown { width: 100%; }
    .dropdown-menu {
      position: static;
      box-shadow: none;
      border: none;
      background: none;
      padding: 0 0 6px 16px;
      margin-top: 0;
      min-width: 0;
    }
    .dropdown-menu a { border-bottom: none; padding: 8px 0; }
  }
</style>

<script>
  const navToggle = document.getElementById('navToggle')!;
  const siteNav = document.getElementById('siteNav')!;

  navToggle.addEventListener('click', () => {
    const open = siteNav.classList.toggle('mobile-open');
    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // Desktop: open dropdown on hover, in addition to native click-to-toggle for touch/keyboard.
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (isFinePointer) {
    document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach((dropdown) => {
      dropdown.addEventListener('mouseenter', () => { dropdown.open = true; });
      dropdown.addEventListener('mouseleave', () => { dropdown.open = false; });
    });
  }
</script>
